<UserControl
    x:Class="LuaToolsGui.Views.Ps5CompanionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:Ps5CompanionViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="8,16,16,24">
            <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Ps5_Title}" />
            <TextBlock Margin="0,3,0,0" FontSize="13" Foreground="#9ca3af"
                       Text="{x:Static res:Strings.Ps5_Subtitle}" TextWrapping="Wrap" />

            <Border Margin="0,18,0,0" Padding="18" Background="#0DFFFFFF"
                    BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold"
                               Text="{x:Static res:Strings.Ps5_ConnectionTitle}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="#9ca3af"
                                       Text="{x:Static res:Strings.Ps5_HostLabel}" />
                            <TextBox Height="34" Padding="8,5"
                                     Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Margin="0,0,0,5" FontSize="12" Foreground="#9ca3af"
                                       Text="{x:Static res:Strings.Ps5_PortLabel}" />
                            <TextBox Height="34" Padding="8,5"
                                     Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Padding="14,7" Content="{x:Static res:Strings.Ps5_Connect}"
                                Command="{Binding ConnectCommand}" />
                        <Button Margin="8,0,0,0" Padding="14,7"
                                Content="{x:Static res:Strings.Ps5_StartPairing}"
                                Command="{Binding StartPairingCommand}" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" FontSize="12.5" Foreground="#9ca3af"
                               Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="#f87171"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#7c8593"
                               Text="{x:Static res:Strings.Ps5_ConnectionHelp}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="18" Background="#0DFFFFFF"
                    BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold"
                               Text="{x:Static res:Strings.Ps5_PairingTitle}" />
                    <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="#9ca3af"
                               Text="{x:Static res:Strings.Ps5_PairingHint}" TextWrapping="Wrap" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="36" Padding="8,6" MaxLength="6"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ConfirmationCode, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,7"
                                Content="{x:Static res:Strings.Ps5_ConfirmPairing}"
                                Command="{Binding ConfirmPairingCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="18" Background="#0DFFFFFF"
                    BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold"
                                   Text="{x:Static res:Strings.Ps5_GamesTitle}" />
                        <Button Grid.Column="1" Padding="12,5" IsEnabled="{Binding IsPaired}"
                                Content="{x:Static res:Strings.Ps5_RefreshGames}"
                                Command="{Binding RefreshGamesCommand}" />
                    </Grid>
                    <ListView Margin="0,12,0,0" Height="230"
                              ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="#9ca3af">
                                            <Run Text="{Binding Kind}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Drive}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,10,0" FontSize="11.5" Foreground="#9ca3af">
                                            <Run Text="App " />
                                            <Run Text="{Binding App}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11.5" Foreground="#9ca3af" Text="{Binding Installed}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button HorizontalAlignment="Left" Padding="14,7"
                                Content="{x:Static res:Strings.Ps5_LoadDetails}"
                                Command="{Binding LoadSelectedGameCommand}" IsEnabled="{Binding IsPaired}" />
                        <Button Margin="8,0,0,0" Padding="14,7"
                                Content="Import Lua profile to Playden"
                                Command="{Binding ImportLuaProfileCommand}" IsEnabled="{Binding IsPaired}" />
                    </StackPanel>
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedGameDetails.Roots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,8,8" Padding="12,6"
                                        Content="{Binding Id}"
                                        IsEnabled="{Binding Exists}"
                                        Command="{Binding DataContext.OpenRootCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,4,0,0" Padding="12" Background="#0AFFFFFF"
                            BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding HasListing, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                           Text="{Binding SelectedRoot.Id}" />
                                <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="#9ca3af" Text="{Binding CurrentPathLabel}" />
                                <Button Grid.Column="2" Margin="12,0,0,0" Padding="10,5"
                                        Content="{x:Static res:Strings.Ps5_RefreshGames}"
                                        Command="{Binding RefreshDirectoryCommand}" />
                            </Grid>
                            <StackPanel Margin="0,10,0,8" Orientation="Horizontal">
                                <Button Padding="10,5" Content="{x:Static res:Strings.Ps5_UpOneLevel}"
                                        Command="{Binding GoUpCommand}" IsEnabled="{Binding HasParentDirectory}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="#9ca3af" Text="{Binding Entries.Count, StringFormat={}{0} items}" />
                            </StackPanel>
                            <ListView Height="260" ItemsSource="{Binding Entries}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <Button HorizontalContentAlignment="Left" Padding="4,3"
                                                    Foreground="#374151" Content="{Binding Name}"
                                                    IsEnabled="{Binding Directory}"
                                                    Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="#9ca3af" Text="{Binding KindLabel}" />
                                            <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="#9ca3af" Text="{Binding ModifiedLabel}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Margin="0,8,0,0" FontSize="11.5" Foreground="#9ca3af"
                                       Text="{Binding UnshownEntries, StringFormat={}{0} more entries not shown}"
                                       Visibility="{Binding ListingTruncated, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
